{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeDesktop",
  "version": "0.1.0",
  "identifier": "com.claudedesktop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClaudeDesktop",
        "label": "main",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 720,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
